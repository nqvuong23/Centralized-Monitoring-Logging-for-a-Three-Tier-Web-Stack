# Edited on Windows, executed on Linux.
# Force LF so no script hits "bad interpreter: /bin/bash^M" from CRLF.
* text=auto eol=lf

*.sh   text eol=lf
*.py   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.j2   text eol=lf
*.cfg  text eol=lf
Vagrantfile text eol=lf

*.png binary
*.jpg binary
*.gz  binary
